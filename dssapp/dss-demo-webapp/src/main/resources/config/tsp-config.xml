<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.3.xsd">

	<!-- External TSA Service (Microsoft TSA) -->
	<!-- To use a different TSA, change the tspServer property -->
	<!-- Alternatives: 
	     - http://ts.quovadisglobal.com/eu (QuoVadis Europa)
	     - http://ts.quovadisglobal.com/ch (QuoVadis Suiza)
	     - https://freetsa.org/tsr (FreeTSA)
	-->
	<bean id="tspSource" class="eu.europa.esig.dss.service.tsp.OnlineTSPSource">
		<property name="tspServer" value="https://timestamp.acs.microsoft.com/" />
	</bean>

